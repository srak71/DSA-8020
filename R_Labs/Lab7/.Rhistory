knitr::opts_chunk$set(echo = TRUE)
data(PlantGrowth)
str(PlantGrowth)
summary(PlantGrowth)
treat_mean <- tapply(PlantGrowth$weight, PlantGrowth$group, mean)
treat_sd <- tapply(PlantGrowth$weight, PlantGrowth$group, sd)
treat_mean, treat_sd
