boxplot(weight ~ group, data = PlantGrowth,
main = "Plant Growth by Treatment",
xlab = "Treatment",
ylab = "Weight",
col = c("lightblue", "lightgreen", "lightcoral"))
boxplot(weight ~ group, data = PlantGrowth,
main = "Plant Growth by Treatment",
xlab = "Treatment",
ylab = "Weight"
