# fit
plant_anova <- aov(weight ~ group, data = PlantGrowth)
summary(plant_anova)
tukey_treats <- TukeyHSD(plant_anova)
print(tukey_treats)
res_plant_anova <- residuals(plant_anova)
qqnorm(res_plant_anova)
qqline(res_plant_anova, col = 'red')
shapiro.test(res_plant_anova)
shapiro.test(res_plant_anova)
fitted_vals <- fitted(plant_anova)
plot(fitted_vals, res_plant_anova, xlab = 'Fitted Values', ylab = 'Residuals', main = 'Residual Plot')
fitted_vals <- fitted(plant_anova)
plot(fitted_vals, res_plant_anova, xlab = 'Fitted Values', ylab = 'Residuals', main = 'Residual Plot', col = 'green')
fitted_vals <- fitted(plant_anova)
plot(fitted_vals, res_plant_anova, xlab = 'Fitted Values', ylab = 'Residuals', main = 'Residual Plot', col = 'grey')
fitted_vals <- fitted(plant_anova)
plot(fitted_vals, res_plant_anova, xlab = 'Fitted Values', ylab = 'Residuals', main = 'Residual Plot', col = 'grey')
abline(h = 0, col = 'red')
