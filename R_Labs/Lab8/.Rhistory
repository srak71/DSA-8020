bill_data <- tibble(
Bact = rep(c("Control", "Mycoplasma"), each = 4),
Temp = rep(c("Warm", "Cold"), times = 4),
Bill_Length = c(40.37, 39.77, 41.71, 40.23, 40.21, 39.19, 40.78, 38.95)
)
bill_data
bill_data <- tibble(
Bact = rep(c("Control", "Mycoplasma"), each = 4),
Temp = rep(c("Warm", "Cold"), times = 4),
Bill_Len = c(40.37, 39.77, 41.71, 40.23, 40.21, 39.19, 40.78, 38.95)
)
bill_data
# Convert to factor
bill_data <- bill_data %>%
mutate(
Bact = as.factor(Bact),
Temp = as.factor(Temp)
)
# Perform ANOVA
bill_anova <- aov(Bill_Len ~ Bact * Temp, data = bill_data)
# Summarize ANOVA results
anova_results <- summary(bill_anova)
anova_results
interaction.plot(
x.factor = bill_data$Bacteria,
trace.factor = bill_data$Temperature,
response = bill_data$Bill_Length,
col = c("red", "blue"),
main = "Bact vs. Temp Interaction Plot",
xlab = "Bacteria Treatment",
ylab = "Bill Length"
)
interaction.plot(
x.factor = bill_data$Bact,
trace.factor = bill_data$Temp,
response = bill_data$Bill_Len,
col = c("red", "blue"),
main = "Bact vs. Temp Interaction Plot",
xlab = "Bacteria Treatment",
ylab = "Bill Length"
)
knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(ggplot2)
library(car)
tip_data <- read.csv("tip_hardness.csv")
head(tip_data)
summary(tip_data)
# converting tip to categorical
tip_data <- tip_data %>%
mutate(Tip = as.factor(Tip))
ggplot(tip_data, aes(x = Tip, y = Hardness, fill = Tip)) +
geom_boxplot() +
labs(title = "Boxplot - Hardness by Tip Type", x = "Tip Type", y = "Hardness") +
theme_minimal()
tip_anova <- aov(Hardness ~ Tip + Coupon, data = tip_data)
summary(tip_anova)
interaction.plot(
x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = c("red", "blue", "green", "purple"),
main = "Tip vs. Coupon Interaction Plot",
xlab = "Tip Type",
ylab = "Hardness"
)
bill_data <- tibble(
Bact = rep(c("Control", "Mycoplasma"), each = 4),
Temp = rep(c("Warm", "Cold"), times = 4),
Bill_Len = c(40.37, 39.77, 41.71, 40.23, 40.21, 39.19, 40.78, 38.95)
)
bill_data
# Convert to factor
bill_data <- bill_data %>%
mutate(
Bact = as.factor(Bact),
Temp = as.factor(Temp)
)
# Perform ANOVA
bill_anova <- aov(Bill_Len ~ Bact * Temp, data = bill_data)
# Summarize ANOVA results
anova_results <- summary(bill_anova)
anova_results
interaction.plot(
x.factor = bill_data$Bact,
trace.factor = bill_data$Temp,
response = bill_data$Bill_Len,
col = c("red", "blue"),
main = "Bact vs. Temp Interaction Plot",
xlab = "Bacteria Treatment",
ylab = "Bill Length"
)
