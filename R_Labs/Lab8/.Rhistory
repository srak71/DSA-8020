knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(ggplot2)
library(car)
tip_data <- read.csv("tip_hardness.csv")
head(tip_data)
summary(tip_data)
ggplot(tip_data, aes(x = Tip, y = Hardness, fill = Tip)) +
geom_boxplot() +
labs(title = "Boxplot of Hardness by Tip Type", x = "Tip Type", y = "Hardness") +
theme_minimal() +
scale_fill_brewer(palette = "Set3") # Adjust colors if needed
ggplot(tip_data, aes(x = Tip, y = Hardness, fill = Tip)) +
geom_boxplot() +
labs(title = "Boxplot of Hardness by Tip Type", x = "Tip Type", y = "Hardness") +
theme_minimal()
# converting tip to categorical
tip_data <- tip_data %>%
mutate(Tip = as.factor(Tip))
ggplot(tip_data, aes(x = Tip, y = Hardness, fill = Tip)) +
geom_boxplot() +
labs(title = "Boxplot of Hardness by Tip Type", x = "Tip Type", y = "Hardness") +
theme_minimal()
tip_anova <- aov(Hardness ~ Tip + Coupon, data = tip_data)
summary(tip_anova)
interaction.plot(x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = rainbow(length(unique(tip_data$Coupon))),
lty = 1,
main = "Interaction Plot: Tip vs. Coupon",
xlab = "Tip Type",
ylab = "Hardness")
interaction.plot(x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
lty = 1,
main = "Interaction Plot: Tip vs. Coupon",
xlab = "Tip Type",
ylab = "Hardness")
interaction.plot(x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = rainbow(length(unique(tip_data$Coupon))),
lty = 1,
main = "Interaction Plot: Tip vs. Coupon",
xlab = "Tip Type",
ylab = "Hardness")
interaction.plot(x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = c("red", "blue", "green", "purple"),  # Manually set colors
lty = 1,
main = "Interaction Plot: Tip vs. Coupon",
xlab = "Tip Type",
ylab = "Hardness")
interaction.plot(x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = c("red", "blue", "green", "purple"),
main = "Interaction Plot: Tip vs. Coupon",
xlab = "Tip Type",
ylab = "Hardness")
interaction.plot(
x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = c("red", "blue", "green", "purple"),
main = "Tip vs. Coupon Interaction Plot",
xlab = "Tip Type",
ylab = "Hardness"
)
ggplot(tip_data, aes(x = Tip, y = Hardness, color = Coupon, group = Coupon)) +
geom_line(aes(group = Coupon), size = 1) +
geom_point(size = 3) +
labs(title = "Interaction Plot: Tip vs. Coupon", x = "Tip Type", y = "Hardness") +
scale_color_brewer(palette = "Set3") +  # Using RColorBrewer palette
theme_minimal()
interaction.plot(
x.factor = tip_data$Tip,
trace.factor = tip_data$Coupon,
response = tip_data$Hardness,
col = c("red", "blue", "green", "purple"),
main = "Tip vs. Coupon Interaction Plot",
xlab = "Tip Type",
ylab = "Hardness"
)
