knitr::opts_chunk$set(echo = TRUE)
library(faraway)
data(fat)
head(fat)
vars <- c("brozek", "age", "weight", "height", "chest", "abdom")
data <- fat[, vars]
vars <- c("brozek", "age", "weight", "height", "chest", "abdom")
data <- fat[, vars]
summary(data)
par(mfrow = c(2, 3))
for (var in vars) {
boxplot(data[[var]], main = var, col = "lightblue")
}
par(mfrow = c(1, 1))
pairs(data, main = "Scatterplot Matrix", col = "blue", pch = 20)
pairs(data, main = "Scatterplot Matrix", col = "blue")
par(mfrow = c(2, 3))
for (var in vars) {
boxplot(data[[var]], main = var, col = "lightblue")
}
pairs(data, main = "Scatterplot Matrix", col = "blue")
full_model <- lm(brozek ~ age + weight + height + chest + abdom, data = data)
summary(full_model)
reduced_model <- lm(brozek ~ age + abdom, data = data)
summary(reduced_model)
anova(reduced_model, full_model)
new_data <- data.frame(age = 54, weight = 197, height = 72.25, chest = 105.375, abdom = 99.325)
predict(full_model, newdata = new_data, interval = "prediction", level = 0.95)
predict(full_model, newdata = new_data, interval = "confidence", level = 0.95)
pairs(data, main = "Scatterplot Matrix")
cor(data)
library(car)
install.packages("car")
library(car)
vif(full_model)
library(car)
vif(full_model)
