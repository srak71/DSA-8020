grids <- expand.grid(x1 = x1g, x2 = x2g)
# pred on grid
grids$pred_y <- predict(copter_gam, newdata = grids)
# visual pred surface heatmap
ggplot(grids, aes(x = x1, y = x2, fill = pred_y)) +
scale_fill_viridis_c() + # match contour plt color
geom_tile() +
