# contour
ggplot(grids, aes(x = x1, y = x2, z = pred_y)) +
geom_contour_filled() +
labs(title = "Contour Plot - Predicted Flight Time",
x = "Rotor Len(cm)",
y = "Leg Len(cm)",
fill = "Predicted Flight Time Bins (sec)") +
theme_minimal()
library(GPfit)
# helper func
norm <- function(x) {
x_normed <- (x - min(x)) / (max(x) - min(x))
return(x_normed)
}
# normalizing data
copter_df$x1_scaled <- norm(copter_df$x1)
copter_df$x2_scaled <- norm(copter_df$x2)
# fitting gaus process
gaus_model <- GP_fit(copter_df[, c("x1_scaled", "x2_scaled")], copter_df$y)
# dense grid
x1g <- seq(6, 10, 0.1)
x2g <- seq(6, 12, 0.2)
grids <- expand.grid(x1 = x1g, x2 = x2g)
# norm dense grid
grids$x1_scaled <- (grids$x1 - min(copter_df$x1)) / (max(copter_df$x1) - min(copter_df$x1))
grids$x2_scaled <- (grids$x2 - min(copter_df$x2)) / (max(copter_df$x2) - min(copter_df$x2))
gaus_preds <- predict(gaus_model, grids[, c("x1_scaled", "x2_scaled")])
# pred uncertainty
grids$pred_sd <- sqrt(gaus_preds$MSE)
ggplot(grids, aes(x = x1, y = x2, fill = pred_sd)) +
geom_tile() +
scale_fill_viridis_c() +
labs(title = "Gaussian Process - Prediction Uncertainty",
x = "Rotor Length (cm)",
y = "Leg Length (cm)",
fill = "Prediction Std. Dev") +
theme_minimal()
# loading libs
library(dplyr)
library(ggplot2)
library(faraway)
library(mgcv)
library(MASS) # for negative binomial
library(mlegp)
# loading data
data(gala)
# remove endemics from dataset
gala <- subset(gala, select = -Endemics)
summary(gala)
head(gala)
# histogram of species
hist(gala$Species, breaks = 10, main = "Distribution of Species Counts", col = 'lightgreen')
# mean vs varience
mean(gala$Species)
var(gala$Species)
# fitting neg binom
gala_negbinom <- glm.nb(Species ~ Area + Elevation + Nearest + Scruz + Adjacent, data = gala)
summary(gala_negbinom)
# optimizing neg binom stepwise
# dir='backward' less risk of overfit than 'both'
optim_galaNB <- step(gala_negbinom, direction = "backward")
summary(optim_galaNB)
par(mfrow = c(2, 2))
plot(optim_galaNB)
# basic linear model
lm_gala <- lm(Species ~ ., data = gala)
# stepwise model selection
optim_galaLM <- step(lm_gala, direction = "backward")
summary(optim_galaLM)
par(mfrow = c(2, 2))
plot(optim_galaLM)
AIC(optim_galaLM, optim_galaNB)
BIC(optim_galaLM, optim_galaNB)
# loading data
load("ProjectII_prob2_data.RData")
