library(dplyr)
library(ggplot2)
library(MASS)
library(mgcv)
library(faraway)
data(gala)
gala
summary(gala)
head(gala)
# getting p-vals
model <- lm(Species ~ Endemics + Area + Elevation + Nearest + Scruz + Adjacent, data = gala)
summary(model)
# residual vs fitted
plot(model, which = 1)
# qq plot
qqnorm(resid(model))
# corelation matrix
cor(gala[, c("Endemics", "Area", "Elevation", "Nearest", "Scruz", "Adjacent")], gala["Species"])
# remove pointless vars iteratively based on AIC
stepmodel <- stepAIC(model, direction = "both")
summary(stepmodel)
bc <- boxcox(stepmodel)
plot(bc)
bc_sqrt_species <- sqrt(gala$Species)
bc_sqrt_model <- lm(bc_sqrt_species ~ Endemics + Area + Elevation, data = gala)
summary(bc_sqrt_model)
# residual vs fitted
plot(bc_sqrt_model, which = 1)
# normal QQ
qqnorm(resid(bc_sqrt_model))
qqline(residuals(bc_sqrt_model))
gam_model <- gam(bc_sqrt_species ~ s(Endemics) + s(Area) + s(Elevation), data = gala)
AIC(bc_sqrt_model, gam_model)
BIC(bc_sqrt_model, gam_model)
# comparing with Box-Cox sqrt model
lm_dev <- deviance(bc_sqrt_model)
null_lm_dev <- deviance(update(bc_sqrt_model, ~ -1))
dev_explained_lm <- 1 - (lm_dev / null_lm_dev)
dev_explained_lm
# gam model
gam_dev <- deviance(gam_model)
null_gam_model <- gam(bc_sqrt_species ~ 1, data = gala)
null_gam_dev <- deviance(null_gam_model)
dev_explained_gam <- 1 - (gam_dev / null_gam_dev)
dev_explained_gam
# checking model assumptions for GAM
# residual vs fitted
plot(gam_model)
# normal QQ
qqnorm(residuals(gam_model))
qqline(residuals(gam_model))
